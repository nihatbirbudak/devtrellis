{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtrellis.example/schemas/public-record-v4-r2.json",
  "title": "K1 v4 r2 public responses: record, tombstone, capabilities, contributor submission view",
  "$comment": "Implemented in branch claude/k1-sunucu-20261107 (radar/katki_v4.py). Every field is server-made; clients never send them. The test tests/test_katki_v4.py compares emitted key sets with this file. quote_match=exact only says the quote occurs verbatim in the gate's visible text of the source on that day; it is not claim truth. Lookup, coverage and error bodies follow r1 lookup-coverage.schema.json, except that lookup `cards[]` items are r2 agent views and the lookup body has a root `freshness` ($defs.lookup_r2); topics shape is $defs.topics.",
  "oneOf": [
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/tombstone"
    },
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/submission"
    },
    {
      "$ref": "#/$defs/agent_view"
    },
    {
      "$ref": "#/$defs/topics"
    },
    {
      "$ref": "#/$defs/lookup_r2"
    }
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "datetime_z": {
      "type": "string",
      "format": "date-time"
    },
    "source_snapshots": {
      "$comment": "alpha.15 record extension 'source_snapshots': optional; one row per source page the gate fetched, keyed by the K0 address_key: when the gate fetched it and the SHA-256 of the gate's normalized visible text (the text the quotes were matched in; extractor version in claims[].evidence.visible_text_version). A trace of the page version, not freshness. Absent on older records.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "address_key": {"$ref": "#/$defs/hex64"},
          "fetched_at": {"$ref": "#/$defs/datetime_z"},
          "visible_text_sha256": {"$ref": "#/$defs/hex64"}
        },
        "required": ["address_key", "fetched_at", "visible_text_sha256"],
        "additionalProperties": false
      }
    },
    "absence_checks": {
      "$comment": "alpha.15 record extension 'absence_notes': optional; present when content.not_in_sources is. Per item (0-based index into content.not_in_sources): how many terms of the item in double quotes or backticks the gate searched (unquoted names are not searched) (it also searched 5-word parts of the item's wording); the address keys of the pages the item says were searched (checked_keys, resolved by the server from the contributor's source numbers at publication, so a later change of the source order cannot move them); the address keys of those pages where a term or wording part was found (found_in_keys, a gate warning); the ids of this record's claims whose quote contains one (found_in_claims, a gate warning). Not finding anything does not prove absence.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "item": {"type": "integer", "minimum": 0},
          "terms": {"type": "integer", "minimum": 0},
          "checked_keys": {"type": "array", "items": {"$ref": "#/$defs/hex64"}},
          "found_in_keys": {"type": "array", "items": {"$ref": "#/$defs/hex64"}},
          "found_in_claims": {"type": "array", "items": {"$ref": "#/$defs/id32"}}
        },
        "required": ["item", "terms", "checked_keys", "found_in_keys", "found_in_claims"],
        "additionalProperties": false
      }
    },
    "record": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "devtrellis-record"
        },
        "schema_version": {
          "const": 4
        },
        "contract": {
          "const": "k1-v4-r2"
        },
        "kind": {
          "enum": [
            "source_card",
            "research_report",
            "topic_summary"
          ]
        },
        "id": {
          "$ref": "#/$defs/id32"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "const": "en"
        },
        "content": {
          "$comment": "Candidate content fields copied verbatim when present: title, summary, short_answer, answers, recommendations, not_covered, applies_to, sources, generated_at, and (alpha.15 record extensions absence_notes / answer_links) not_in_sources, not_researched. These free-text fields are not tied to any source (see publication.gate.fields_not_tied_to_sources). Shapes follow contribution-candidate-v4-r2.schema.json.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "title",
              "summary",
              "short_answer",
              "answers",
              "recommendations",
              "not_covered",
              "applies_to",
              "sources",
              "generated_at",
              "not_in_sources",
              "not_researched"
            ]
          },
          "properties": {
            "answers": {
              "$comment": "alpha.15 answer_links: items are strings (older form) or {q, claims} / {q, inferred_from} with 1-based claim numbers of this record.",
              "type": "array",
              "items": {
                "anyOf": [
                  {"type": "string"},
                  {"type": "object", "required": ["q", "claims"], "additionalProperties": false,
                   "properties": {"q": {"type": "string"}, "claims": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "maxItems": 10}}},
                  {"type": "object", "required": ["q", "inferred_from"], "additionalProperties": false,
                   "properties": {"q": {"type": "string"}, "inferred_from": {"type": "array", "items": {"type": "integer", "minimum": 1}, "maxItems": 10}}}
                ]
              }
            },
            "not_in_sources": {
              "$comment": "alpha.15 absence_notes: contributor's statement that the listed sources (1-based reading-order numbers: content.sources first, then claim URLs missing from it) do not state item. Not verified by DevTrellis. The numbers are the contributor's, valid for the source order at publication; readers use publication.gate.absence_checks[].checked_keys (address keys resolved by the server) instead, because the order can change later.",
              "type": "array",
              "items": {"type": "object", "required": ["item", "checked"], "additionalProperties": false,
                        "properties": {"item": {"type": "string"}, "checked": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "maxItems": 10}}}
            },
            "not_researched": {
              "$comment": "alpha.15 absence_notes: topics the contributor did not look into.",
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id32"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "claim_type": {
                "anyOf": [
                  {
                    "enum": [
                      "source_statement",
                      "procedure",
                      "version_scope",
                      "measurement",
                      "interpretation"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "applies_to": {
                "anyOf": [
                  {
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "source_url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "address_key": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/hex64"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "$comment": "K0 address_key(source_url, 'en'); null if K0 rejects the URL."
                  },
                  "quote_hash": {
                    "$ref": "#/$defs/hex64",
                    "$comment": "SHA-256 of the gate-normalized quote (whitespace runs, typographic quotes and dashes mapped)."
                  },
                  "normalization_version": {
                    "const": "gorunur-metin-bosluk-tirnak-tire-v1"
                  },
                  "visible_text_version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "$comment": "Gate visible-text extractor version, e.g. gorunur-metin-bosluk-tirnak-tire-v3."
                  },
                  "checked_on": {
                    "type": "string",
                    "format": "date",
                    "$comment": "Contributor-declared; the server-side check time is quote_match.quote_verified_at."
                  },
                  "section_id": {
                    "type": "null",
                    "$comment": "Reserved for K0 extract_document binding; null in this slice."
                  },
                  "section_hash": {
                    "type": "null"
                  },
                  "supporting_context_hash": {
                    "type": "null"
                  }
                },
                "required": [
                  "quote",
                  "source_url",
                  "address_key",
                  "quote_hash",
                  "normalization_version",
                  "visible_text_version",
                  "checked_on",
                  "section_id",
                  "section_hash",
                  "supporting_context_hash"
                ],
                "additionalProperties": false
              },
              "quote_match": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "exact"
                  },
                  "quote_verified_at": {
                    "$ref": "#/$defs/datetime_z"
                  }
                },
                "required": [
                  "state",
                  "quote_verified_at"
                ],
                "additionalProperties": false
              },
              "claim_review": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "not_reviewed"
                  },
                  "reviewed_at": {
                    "type": "null"
                  }
                },
                "required": [
                  "state",
                  "reviewed_at"
                ],
                "additionalProperties": false
              },
              "evidence_state": {
                "const": "current"
              }
            },
            "required": [
              "id",
              "text",
              "claim_type",
              "applies_to",
              "evidence",
              "quote_match",
              "claim_review",
              "evidence_state"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "$comment": "Copied from the candidate (contributor declaration)."
        },
        "rights": {
          "type": "object",
          "properties": {
            "own_text_license": {
              "enum": [
                "CC0-1.0",
                "CC-BY-4.0"
              ]
            },
            "quotes": {
              "type": "object",
              "properties": {
                "basis": {
                  "const": "source_linked_short_quote"
                },
                "max_chars": {
                  "const": 300
                }
              },
              "required": [
                "basis",
                "max_chars"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "own_text_license",
            "quotes"
          ],
          "additionalProperties": false
        },
        "publication": {
          "type": "object",
          "properties": {
            "state": {
              "const": "published"
            },
            "path": {
              "enum": [
                "machine_gate",
                "moderator"
              ]
            },
            "policy_version": {
              "const": "k1-publication-gates-v1"
            },
            "published_at": {
              "$ref": "#/$defs/datetime_z"
            },
            "human_reviewed": {
              "type": "boolean",
              "$comment": "true only on the moderator path; even then claims are not individually verified."
            },
            "gate": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "ran_at": {
                  "$ref": "#/$defs/datetime_z"
                },
                "input_sha256": {
                  "$ref": "#/$defs/hex64"
                },
                "checks_passed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fields_not_tied_to_sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "machine_not_covered": {
                  "$comment": "alpha.13b record extension 'machine_not_covered' (capabilities.record_extensions): optional; page sections (headings, definition ids, list items) the gate found without any quote, at most 12 short names taken from the source page (third-party text). Absent when the gate did not fetch the sources or the record predates the extension.",
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "source_snapshots": {
                  "$ref": "#/$defs/source_snapshots"
                },
                "absence_checks": {
                  "$ref": "#/$defs/absence_checks"
                }
              },
              "required": [
                "version",
                "ran_at",
                "input_sha256",
                "checks_passed",
                "warnings",
                "fields_not_tied_to_sources"
              ],
              "additionalProperties": false
            },
            "label": {
              "type": "object",
              "$comment": "machine_gate: the gate's kanit_etiketi / kanit_etiketi_en verbatim ('İnsan incelemedi; …' / 'Not human-reviewed; …'). moderator: first clause replaced by who published.",
              "properties": {
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "tr",
                "en"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "path",
            "policy_version",
            "published_at",
            "human_reviewed",
            "gate",
            "label"
          ],
          "additionalProperties": false
        },
        "corrections": {
          "type": "object",
          "properties": {
            "open": {
              "type": "integer",
              "minimum": 0
            },
            "latest_public_version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "public_note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "open",
            "latest_public_version",
            "public_note"
          ],
          "additionalProperties": false
        },
        "link": {
          "type": "string",
          "pattern": "^https?://",
          "$comment": "{origin}/api/community/v4/records/{id}/v/{version}"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "contract",
        "kind",
        "id",
        "version",
        "language",
        "content",
        "claims",
        "provenance",
        "rights",
        "publication",
        "corrections",
        "link"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "$comment": "alpha.15 (14a) record extension 'lineage' (capabilities.record_extensions): present only on a version built by an extension (record_extension submission). versions = the chain of this version's ancestors and itself, oldest first. Claims are only ever appended, so the claims a version added are the next `claims` entries in record order. change_summary and provenance are the contributor's declarations (untrusted text); path and human_reviewed are server facts for that version.",
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "published_at": {
                "$ref": "#/$defs/datetime_z"
              },
              "path": {
                "enum": [
                  "machine_gate",
                  "moderator"
                ]
              },
              "human_reviewed": {
                "type": "boolean"
              },
              "claims": {
                "type": "integer",
                "minimum": 0
              },
              "based_on": {
                "type": "integer",
                "minimum": 1
              },
              "seen_version": {
                "type": "integer",
                "minimum": 1
              },
              "change_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "provenance": {
                "type": "object"
              }
            },
            "required": [
              "version",
              "published_at",
              "path",
              "human_reviewed",
              "claims",
              "provenance"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "versions"
      ],
      "additionalProperties": false
    },
    "tombstone": {
      "$comment": "HTTP 410 for a record that was public and then withdrawn by the contributor or removed by a moderator. Never-published ids return 404 with no tombstone.",
      "type": "object",
      "properties": {
        "schema": {
          "const": "devtrellis-record-tombstone"
        },
        "schema_version": {
          "const": 4
        },
        "contract": {
          "const": "k1-v4-r2"
        },
        "id": {
          "$ref": "#/$defs/id32"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "withdrawn",
            "removed"
          ]
        },
        "removed_at": {
          "$ref": "#/$defs/datetime_z"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "contract",
        "id",
        "version",
        "state",
        "removed_at"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "$comment": "GET /api/community/capabilities; 404 when the K1 path is disabled (client falls back explicitly).",
      "type": "object",
      "properties": {
        "schema": {
          "const": "devtrellis-capabilities"
        },
        "schema_version": {
          "const": 1
        },
        "contract": {
          "const": "k1-v4-r2"
        },
        "record_schema_version": {
          "const": 4
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submissions": {
          "const": true
        },
        "auto_publish": {
          "type": "boolean",
          "$comment": "Configured setting (auto_publish in the settings file). The publishing stop switch is not exposed publicly."
        },
        "quote_rule": {
          "const": "gorunur-metin-bosluk-tirnak-tire-v1"
        },
        "quote_basis": {
          "const": "source_linked_short_quote"
        },
        "own_text_licenses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lookup": {
          "type": "boolean",
          "$comment": "GET /api/community/sources/{address_key}; source cards only."
        },
        "coverage": {
          "type": "boolean",
          "$comment": "GET /api/community/coverage (r1 lookup-coverage.schema.json coverage shape)."
        },
        "source_checks": {
          "const": false
        },
        "does_not_prove_tr": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "boolean",
          "$comment": "GET /api/community/topics (devtrellis-topics v1)."
        },
        "record_extensions": {
          "$comment": "alpha.13b: optional record extensions this server writes; a strict reader accepts their fields only when listed here. Known: machine_not_covered (publication.gate and agent_view.server); alpha.15: source_snapshots (publication.gate and agent_view.server), absence_notes (content.not_in_sources, content.not_researched; publication.gate.absence_checks and agent_view.server.absence_checks), answer_links (content.answers items may be objects). alpha.15 (14a): lineage (top-level record.lineage; agent_view.server.extended and agent_view.declared.provenance_by_version).",
          "type": "array",
          "items": {
            "enum": [
              "machine_not_covered",
              "source_snapshots",
              "absence_notes",
              "answer_links",
              "lineage"
            ]
          }
        },
        "extensions": {
          "$comment": "alpha.15 (14a): present (true) only when the server accepts record_extension submissions (settings key 'extensions'). Absent: the extension path is off; records already extended may still be served (then record_extensions lists 'lineage').",
          "const": true
        }
      },
      "required": [
        "schema",
        "schema_version",
        "contract",
        "record_schema_version",
        "kinds",
        "submissions",
        "auto_publish",
        "quote_rule",
        "quote_basis",
        "own_text_licenses",
        "lookup",
        "coverage",
        "topics",
        "source_checks",
        "does_not_prove_tr"
      ],
      "additionalProperties": false
    },
    "submission": {
      "$comment": "Private contributor view {\"submission\": …} returned with the capability token; never public.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id32"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "retry_wait",
            "rejected",
            "unverifiable",
            "pending_review",
            "published",
            "review_rejected",
            "withdrawn",
            "removed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "next_attempt_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/datetime_z"
            },
            {
              "type": "null"
            }
          ]
        },
        "hold_reason": {
          "anyOf": [
            {
              "enum": [
                "auto_publish_off",
                "publishing_stopped",
                "auto_publish_daily_cap",
                "extension_coverage_removal",
                "extension_conflict",
                "extension_daily_cap",
                "instruction_like_content"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "verdict": {
                  "enum": [
                    "yayimlanir",
                    "reddedilir",
                    "yayimlanamaz"
                  ]
                },
                "gate_version": {
                  "type": "string"
                },
                "ran_at": {
                  "$ref": "#/$defs/datetime_z"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "uncheckable": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "checks": {
                  "type": "array"
                }
              },
              "required": [
                "verdict",
                "gate_version",
                "ran_at",
                "reasons",
                "uncheckable",
                "warnings"
              ]
            }
          ]
        },
        "published_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/datetime_z"
        },
        "updated_at": {
          "$ref": "#/$defs/datetime_z"
        },
        "extension": {
          "$comment": "alpha.15 (14a): only for a record_extension submission. record_id = the extended record; seen_version = the version the contributor previewed against; version = the record version this submission published (null until published); current = that version is the record's visible version.",
          "type": "object",
          "properties": {
            "record_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id32"
                },
                {
                  "type": "null"
                }
              ]
            },
            "seen_version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "current": {
              "type": "boolean"
            }
          },
          "required": [
            "record_id",
            "seen_version",
            "version",
            "current"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "revision",
        "attempts",
        "next_attempt_at",
        "hold_reason",
        "note",
        "gate",
        "published_version",
        "link",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "agent_view": {
      "$comment": "GET /api/community/v4/records/{id}/agent (engineering report K3). server = server-made facts; declared = contributor declarations; untrusted = contributor free text, claim texts, quotes and source URLs. server.content_sha256 = canonical SHA-256 of untrusted. /agent.txt renders the same with untrusted JSON between per-response random markers 'BEGIN UNTRUSTED <32 hex>' / 'END UNTRUSTED <32 hex>'.",
      "type": "object",
      "properties": {
        "schema": {
          "const": "devtrellis-agent-view"
        },
        "schema_version": {
          "const": 1
        },
        "contract": {
          "const": "k1-v4-r2"
        },
        "server": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "version",
            "language",
            "content_sha256",
            "published_at",
            "path",
            "human_reviewed",
            "gate_version",
            "gate_ran_at",
            "checks_passed",
            "warnings",
            "fields_not_tied_to_sources",
            "label",
            "quote_rights",
            "corrections",
            "link",
            "quote_matches"
          ],
          "additionalProperties": false,
          "properties": {
            "machine_not_covered": {
              "$comment": "alpha.13b record extension 'machine_not_covered' (capabilities.record_extensions): optional; page sections (headings, definition ids, list items) the gate found without any quote, at most 12 short names taken from the source page (third-party text). Absent when the gate did not fetch the sources or the record predates the extension.",
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "source_snapshots": {
              "$ref": "#/$defs/source_snapshots"
            },
            "absence_checks": {
              "$ref": "#/$defs/absence_checks"
            },
            "extended": {
              "$comment": "alpha.15 (14a), only when the record carries lineage: per version the claim numbers it added (1-based, record order; [] when none), path, publication time and human review. With lineage (acceptance round 1, Ö3), server.human_reviewed is true only when every version is, and declared.provenance merges all versions' declarations (origin mixed when they differ); per-version values are here and in declared.provenance_by_version. Server facts only; the change summary stays in record.lineage.",
              "type": "object",
              "properties": {
                "from_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "versions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "added_claims": {
                        "type": "array",
                        "maxItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "path": {
                        "enum": [
                          "machine_gate",
                          "moderator"
                        ]
                      },
                      "published_at": {
                        "$ref": "#/$defs/datetime_z"
                      },
                      "human_reviewed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "version",
                      "added_claims",
                      "path",
                      "published_at",
                      "human_reviewed"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "from_version",
                "versions"
              ],
              "additionalProperties": false
            }
          }
        },
        "declared": {
          "type": "object",
          "required": [
            "provenance",
            "generated_at",
            "own_text_license",
            "claims"
          ],
          "properties": {
            "provenance_by_version": {
              "$comment": "alpha.15 (14a), only when the record carries lineage: each version's declared provenance (contributor declaration).",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "provenance": {
                    "type": "object"
                  }
                },
                "required": [
                  "version",
                  "provenance"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "untrusted": {
          "type": "object",
          "required": [
            "content",
            "claims"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "schema_version",
        "contract",
        "server",
        "declared",
        "untrusted"
      ],
      "additionalProperties": false
    },
    "topics": {
      "$comment": "GET /api/community/topics. Terms come only from contribution-time applies_to product slugs; never from search queries or reads.",
      "type": "object",
      "properties": {
        "schema": {
          "const": "devtrellis-topics"
        },
        "schema_version": {
          "const": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "library_revision": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "properties": {
              "card": {
                "type": "object",
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              "kind": {
                "enum": [
                  "research",
                  "topic_summary",
                  "source_card"
                ]
              },
              "products": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "properties": {
                    "product": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "versions": {
                      "type": "array",
                      "maxItems": 10,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,39}$"
                      }
                    }
                  },
                  "required": [
                    "product",
                    "versions"
                  ],
                  "additionalProperties": false
                }
              },
              "terms": {
                "type": "array",
                "maxItems": 60,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            },
            "required": [
              "card",
              "kind",
              "products",
              "terms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "schema_version",
        "generated_at",
        "valid_until",
        "library_revision",
        "complete",
        "entries"
      ],
      "additionalProperties": false
    },
    "lookup_r2": {
      "$comment": "GET /api/community/sources/{address_key}. Body = r1 lookup-coverage.schema.json `lookup` plus root `freshness`; cards[] items are r2 agent views ($defs.agent_view). answer_eligible = version/scope/withdrawal eligibility only, independent of freshness; clients show freshness separately (state unknown until K0 source tracking is bound).",
      "type": "object",
      "properties": {
        "freshness": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "fresh",
                "stale",
                "unknown"
              ]
            },
            "checked_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "checked_at"
          ],
          "additionalProperties": false
        },
        "cards": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/agent_view"
          }
        }
      },
      "required": [
        "freshness"
      ]
    }
  }
}
